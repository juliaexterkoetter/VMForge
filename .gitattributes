# Normalização automática de arquivos de texto
* text=auto

# Código-fonte e documentação com LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts nativos do Windows com CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
